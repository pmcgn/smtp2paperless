# Copy to .env for local development. A `.env` file in the working directory is
# loaded automatically (real environment variables take precedence).

# --- paperless-ngx (required) ---
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=change-me
# Alternative to PAPERLESS_TOKEN, e.g. for Docker secrets:
# PAPERLESS_TOKEN_FILE=/run/secrets/paperless_token

# Optional metadata applied to every upload (numeric IDs from paperless-ngx)
# PAPERLESS_TAGS=1,2
# PAPERLESS_CORRESPONDENT=3
# PAPERLESS_DOCUMENT_TYPE=4
# PAPERLESS_CUSTOM_PATH=/api/documents/post_document/
# PAPERLESS_HTTP_TIMEOUT=60s
# PAPERLESS_UPLOAD_RETRIES=3

# --- SMTP ---
SMTP_PORT=2525
# SMTP_DOMAIN=localhost
# SMTP_MAX_MESSAGE_BYTES=52428800
# SMTP_MAX_RECIPIENTS=50
# SMTP_TIMEOUT=5m

# Comma separated file extensions to upload (jpg/jpeg and tif/tiff are equivalent)
ATTACHMENT_WHITELIST=tiff,pdf,jpg

# --- Observability ---
# debug | info | warn | error
LOG_LEVEL=debug
# text | json
LOG_FORMAT=text
# serves /metrics and /healthz
METRICS_PORT=9090
